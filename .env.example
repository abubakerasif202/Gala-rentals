# NODE_ENV is managed by npm/Vite locally and by the hosting provider in production.
# NODE_ENV=production
PORT=3000

# Public production URLs
PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
VITE_API_BASE_URL=/api
# FRONTEND_URL=http://localhost:3000
# CORS_ORIGIN=http://localhost:3000
# JSON_BODY_LIMIT=100kb

# Admin login
ADMIN_EMAIL=admin@galarentals.com.au
# Local-only admin fallback login for development. Do not use in production.
# ADMIN_PASSWORD=change_me

# Database
# Use Supabase DIRECT/session-capable Postgres URL, not transaction pooler
DATABASE_URL=
SUPABASE_DB_URL=

# Supabase backend secrets
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VEHICLE_IMAGES_BUCKET=vehicle-images

# Supabase frontend public vars
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_VEHICLE_IMAGES_BUCKET=vehicle-images

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=
CHECKOUT_LINK_SECRET=
# STRIPE_SECURITY_BOND_PRODUCT_ID=prod_...
# STRIPE_ONBOARDING_SETUP_PRODUCT_ID=prod_...
# STRIPE_WEEKLY_RENTAL_PRODUCT_ID=prod_...

# Email / Resend
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Background jobs
BACKGROUND_JOB_QUEUE=default
# DOCUMENT_PDF_QUEUE_NAME=default
# BACKGROUND_JOB_POLL_INTERVAL_MS=2000
# BACKGROUND_JOB_LEASE_MS=300000

# SEO / indexing
INDEXNOW_KEY=
INDEXNOW_ENABLED=false
# INDEXNOW_TIMEOUT_MS=7000
# INDEXNOW_DEBOUNCE_MS=2000

# App security
JWT_SECRET=replace_with_at_least_32_random_characters

# Required for signed checkout links, redirects, and webhook checks.
APP_URL=http://localhost:3000

# Lease agreement defaults
LEASE_OWNER_NAME=Sarfraz Ahmad
LEASE_OWNER_ADDRESS=24 Kinghorne St, Gledswood Hills NSW 2557
LEASE_OWNER_CONTACT=+61415228557
LEASE_OWNER_EMAIL=admin@galarentals.com.au
# LEASE_RETURN_NOTICE_DAYS=14

# Vercel-only controls. Leave preview writes and production cron disabled initially.
GALA_PREVIEW_WRITES_ENABLED=false
# Must equal the independently verified isolated staging SUPABASE_URL.
GALA_STAGING_SUPABASE_URL=
# All preview email recipients are replaced with this controlled test inbox.
GALA_PREVIEW_EMAIL_TO=
GALA_CRON_ENABLED=false
CRON_SECRET=
# VERCEL / VERCEL_ENV / VERCEL_URL are provided by Vercel, never set manually.
# Preview: STRIPE_SECRET_KEY must use sk_test_, never live keys.
# Production: APP_URL=https://www.galarentals.com.au

# Optional operator/runtime variables referenced by source; enable only as needed.
# ALLOW_LEGACY_IMPORT=
# ALLOW_SCHEMA_RESET=
# ALLOW_STRIPE_RESET=
# ALLOW_SUBSCRIPTION_BACKFILL=
# CSP_REPORTING=
# CSP_REPORT_URI=
# GALA_FLEET_POWERSHELL_BIN=
# LOAD_TEST_ALLOW_PRODUCTION=
# LOAD_TEST_BASE_URL=
# LOAD_TEST_CONCURRENCY=
# LOAD_TEST_DURATION_SECONDS=
# LOAD_TEST_MAX_ERROR_RATE=
# LOAD_TEST_OUTPUT=
# LOAD_TEST_P95_MS=
# LOAD_TEST_P99_MS=
# LOAD_TEST_PROFILE=
# LOAD_TEST_RAMP_SECONDS=
# LOAD_TEST_REQUEST_DELAY_MS=
# LOAD_TEST_TIMEOUT_MS=

# Optional environment settings passed to GalaRentals operator scripts.
# GALA_FLEET_CLIENT_WORKBOOK_PATH=
# GALA_FLEET_INVOICE_WORKBOOK_PATH=
# GALA_FLEET_SOURCE=
# GALA_FLEET_WORKBOOK_PATH=

# Optional separate PRIVATE staging bucket; must allow 15 MB vehicle images.
# Do not repurpose the public vehicle-images bucket for identity-document staging.
SUPABASE_UPLOAD_STAGING_BUCKET=

# Server-only PEM root certificate downloaded from this Supabase project's
# Database Settings. Required for certificate-verified PostgreSQL on Vercel.
POSTGRES_SSL_CA=
